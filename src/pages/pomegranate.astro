---
import { promises as fs } from "node:fs"
import { join } from "path"
import Main from "@/layouts/main.astro"
import { Row, Cell, SiteHeader } from "@/components"

const trackList = [
  "periodic signals",
  "three days",
  "make me see",
  "bleached",
  "clay",
  "no pasa nada",
  "they won't hurt",
  "pomegranate",
  "lullaby for angels",
  "fallen angels",
  "not your heart to break",
  "a thousand planes in the sky",
  "little star",
  "everything flows",
  "hold me close for one more time",
]

const lyricsPath = join(process.cwd(), "src", "lyrics")

const lyrics = await Promise.all(
  trackList.map(async (track) => {
    const filePath = join(lyricsPath, track + ".txt")
    const content = await fs.readFile(filePath, "utf-8")
    return {
      title: track.trim(),
      text: content.trim(),
    }
  }),
)
---

<Main title="pomegranate" description="an album by july" favicon="/favicon.svg">
  <div class="mx-auto">
    <div
      x-data={`{
             lyrics: ${JSON.stringify(lyrics)},
             activeTrack: ${JSON.stringify(lyrics[0])},
             formatLyrics: (text) => {
             return text.split('\\n').join('<br>')
             },
             findTrackByName(name) {
             return this.lyrics.find(track => track.title.toLowerCase() === name.toLowerCase()) || this.lyrics[0]
             }
             }`}
      x-init={`() => {
             const hash = decodeURIComponent(window.location.hash.slice(1));
             if (hash) {
             activeTrack = findTrackByName(hash);
             }
             }`}
      x-cloak
    >
      <div class="ledger">
        <SiteHeader mb={2} />

        <!-- title + listen (left) -->
        <Row mb={1}>
          <Cell col={1} span={4} smCol={1} smSpan={12} class="cell-title">
            pomegranate
          </Cell>

          <Cell col={1} span={4} smCol={1} smSpan={12}>
            <a
              href="https://untitled.stream/library/project/DwD6kKYkicbwKpja762ae"
              class="link font-normal inline-block"
              target="_blank">listen</a
                                           >
          </Cell>
        </Row>

        <!-- track list (left, sticky) + lyrics (right) on one row -->
        <Row mt={1}>
          <Cell col={1} span={4} smCol={1} smSpan={12} smRow={1}>
            <ul class="track-list">
              <template x-for="(track, index) in lyrics">
                <li
                  class="track cell"
                  :class="{ 'track-active': activeTrack.title === track.title }"
                  x-on:click="activeTrack = track; $nextTick(() => document.getElementById('lyrics-title').scrollIntoView({behavior: 'smooth'}))"
                  x-text="`${(index + 1) < 10 ? '0' : ''}${index + 1}` + '. ' + track.title"
                >
                </li>
              </template>
            </ul>
          </Cell>

          <Cell col={6} span={7} smCol={1} smSpan={12} smRow={2}>
            <div class="lyrics-pane md:sticky md:top-8 md:self-start">
              <h2
                id="lyrics-title"
                class="cell-title block mb-[var(--band)]"
                x-text="activeTrack.title"
              >
              </h2>
              <div
                class="lyrics-body whitespace-pre-wrap break-words md:overflow-y-auto"
                x-html="formatLyrics(activeTrack.text)"
              >
              </div>

              <div class="md:hidden mt-8">
                <template
                  x-if="lyrics.indexOf(activeTrack) < lyrics.length - 1"
                >
                  <p
                    class="link cursor-pointer"
                    x-text="'next: ' + lyrics[lyrics.indexOf(activeTrack) + 1].title"
                    x-on:click="activeTrack = lyrics[lyrics.indexOf(activeTrack) + 1]; $nextTick(() => document.getElementById('lyrics-title').scrollIntoView({behavior: 'smooth'}))"
                  >
                  </p>
                </template>
              </div>
            </div>
          </Cell>
        </Row>
      </div>
    </div>
  </div>
</Main>

<style>
  [x-cloak] {
    display: none !important;
  }

  /* track list rendered as ledger cells (one band each); clickable, with the
     active track promoted to the cell-title look (foreground + semibold). */
  .track-list {
    @apply list-none p-0 m-0;
  }
  .track {
    @apply cursor-pointer;
    line-height: var(--band);
    font-size: var(--band-font);
  }
  .track:hover {
    @apply text-foreground;
  }
  .track-active {
    @apply font-semibold text-foreground;
  }

  /* lyrics rest on the ledger rules: each line is one band tall */
  .lyrics-body {
    line-height: var(--band);
    font-size: var(--band-font);
    @apply text-foreground;
  }

  /* always give every track 6 empty bands of breathing room under the lyrics
     so they never end abruptly against the page edge. */
  .lyrics-body {
    padding-bottom: calc(var(--band) * 6);
  }

  /* the ledger sheet always fills at least the viewport, so short lyrics don't
     leave a stubby half-page of ruling. Drop the top/bottom hairline so the
     sheet is exactly 100vh (no 2px overflow → no page scroll on desktop). */
  .ledger {
    min-height: 100vh;
    @apply border-y-0;
  }

  /* ── desktop (≥640px): the page itself must not scroll. The lyrics pane is
     sticky at top:2rem; the lyrics body takes the remaining viewport height and
     scrolls INTERNALLY when a song is long, so the page never scrolls. ── */
  @media (min-width: 640px) {
    .lyrics-pane {
      /* the pane's grid row starts ~8 bands down (site header + title rows), so
         cap it to the viewport minus that so paneTop + height never exceeds the
         screen — keeping the page itself unscrolled. */
      max-height: calc(100vh - var(--band) * 8);
      display: flex;
      flex-direction: column;
    }
    .lyrics-pane .lyrics-body {
      flex: 1;
      min-height: 0; /* allow the flex child to shrink so overflow kicks in */
      overflow-y: auto;
    }
  }

  /* ── mobile (≤639px): lyrics scroll smoothly to ~2 bands above the title
     (scroll-margin is honoured by scrollIntoView), and a 3-band gap separates
     the track list from the lyrics. ── */
  @media (max-width: 639px) {
    #lyrics-title {
      scroll-margin-top: calc(var(--band) * 2);
    }
    .lyrics-pane {
      margin-top: calc(var(--band) * 3);
    }
  }
</style>
