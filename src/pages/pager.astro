---
import { Row, Cell, SiteHeader, ImageCell } from "@/components"
import Main from "@/layouts/main.astro"
import Kbd from "@/components/Kbd.astro"

// shared body column for the prose, so every paragraph block lines up
const BODY = { col: 3, span: 5, smCol: 1, smSpan: 12 } as const
---

<Main
  htmlClass="pager-page"
  title="pager - share a line of thought"
  description="pager is a tiny macOS app that feels like a note you pass to your crush in class."
  favicon="/pager/pager-logo.svg"
>
  <div class="mx-auto">
    <div class="ledger">
      <SiteHeader mb={2} />

      <!-- logo plate -->
      <Row mb={0}>
        <ImageCell
          src="/pager/pager-logo.svg"
          alt="pager app logo"
          col={3}
          span={2}
          smCol={1}
          smSpan={3}
          bands={4}
          pad={0}
        />
      </Row>

      <!-- title · subtitle -->
      <Row mt={1}>
        <Cell col={3} span={2} smCol={1} smSpan={5} smRow={1} class="cell-title">
          pager
        </Cell>
        <Cell col={5} span={8} smCol={6} smSpan={7} smRow={1}>
          share a line of thought
        </Cell>
      </Row>

      <!-- description -->
      <Row mt={1}>
        <Cell {...BODY}>
          a single note that sits in your menu bar, synced with someone that matters to you.
        </Cell>
      </Row>
      <Row mt={1}>
        <Cell {...BODY}>
          share a thought, a joke, a link. share a moment.
        </Cell>
      </Row>
      <Row mt={1}>
        <Cell {...BODY}>
          no history, no feed, no notifications: just a quiet, shared thought that lives in your periphery.
        </Cell>
      </Row>
      <Row mt={1}>
        <Cell {...BODY}>
          pager feels like a note that you pass to your crush in class. like a post-it in your lunchbox, saying &ldquo;i love you&rdquo; or &ldquo;have a wonderful day&rdquo;.
        </Cell>
      </Row>

      <!-- download CTA -->
      <Row mt={2}>
        <Cell {...BODY}>
          <span class="hilite mr-2">curious?</span>
          <a href="/pager/Pager.zip" download class="link">download pager for free</a>
        </Cell>
        <Cell {...BODY}>
            <span class="muted">(only macOS)</span>
        </Cell>
      </Row>

      <!-- installation notes -->
      <Row mt={3} mb={1}>
        <Cell {...BODY} class="cell-header">note on installation</Cell>
      </Row>
      <Row>
        <Cell {...BODY}>
          to install, download <Kbd>Pager.zip</Kbd> from the link above, unzip it, and drag <Kbd>Pager.app</Kbd> to Applications.
        </Cell>
      </Row>
      <Row mt={1}>
        <Cell {...BODY}>
          while pager is in beta, macOS will complain when you open it (&ldquo;Apple could not verify&hellip;&rdquo;). close that dialog (don&rsquo;t move it to Trash).
        </Cell>
      </Row>
      <Row mt={1}>
        <Cell {...BODY}>
          open <span class="hilite">System Settings &rarr; Privacy &amp; Security</span>, scroll down, and click <span class="hilite">Open Anyway</span> next to &ldquo;Pager.app was blocked&hellip;&rdquo;.
        </Cell>
      </Row>
      <Row mt={1} mb={4}>
        <Cell {...BODY}>
          that&rsquo;s it; pager will live in your menu bar (it shows up as 📟). on first run it asks you to create a pager (send the code to your BFF, lover, or sibling) or join with a code you received. enable <span class="hilite">Launch at login</span> so it&rsquo;s always there.
        </Cell>
      </Row>
    </div>
  </div>
</Main>
